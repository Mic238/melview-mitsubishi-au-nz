{
  "displayName": "AU/NZ Mitsubishi Air-Conditioners Bridge",
  "name": "homebridge-airconditioner-mitsubishi-au-nz",
  "version": "1.3.0",
  "description": "Control your Mitsubishi Aircon units with Homebridge and Apple HomeKit",
  "license": "Apache-2.0",
